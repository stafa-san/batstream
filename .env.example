# ============================================================
# PUBLIC — ships to the browser, secured by Firestore rules.
# Safe to expose (the web API key is not a secret).
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Realtime Database URL — create the RTDB instance in the Firebase console
# first (Build → Realtime Database), then copy its URL here.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Demo HLS playlist (.m3u8) for the window until the barn camera exists.
NEXT_PUBLIC_STREAM_URL=

# ============================================================
# SERVER ONLY — Vercel secrets. NEVER prefix these NEXT_PUBLIC_.
# The Admin service-account key with that prefix = full DB access
# leaked to every browser.
# ============================================================
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private_key from the service-account JSON, kept as one line
# with literal \n sequences.
FIREBASE_ADMIN_PRIVATE_KEY=
DEMO_ENABLED=true
SEED_TOKEN=

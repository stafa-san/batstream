{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$siteSlug": {
        ".read": true,
        "$connId": {
          ".write": "!data.exists() || newData.val() == null",
          ".validate": "newData.val() == null || newData.isNumber() || newData.isBoolean()"
        }
      }
    }
  }
}
